LOOKUP_PROVIDER=sample
# Internal customer-service query mode. It uses one authorized company API Key to read customer-requested waybills.
# INTERNAL_QUERY_SOURCE=central-api
# CENTRAL_NEW_WISDOM_API_TOKEN=store-in-secret-manager
# For a future approved browser workflow only. It is intentionally unavailable until the workflow is implemented.
# INTERNAL_QUERY_SOURCE=rpa
# LOOKUP_PROVIDER=new-wisdom
# For customer self-service, configure this JSON only in the deployment secret manager.
# The portal resolves the logged-in tenant to its own Key; never send these values to the browser.
# TENANT_NEW_WISDOM_TOKENS_JSON={"tenant-a":"customer-a-access-token","tenant-b":"customer-b-access-token"}
# NEXTSLS_USERNAME=read-only-service-account
# NEXTSLS_PASSWORD=store-in-secret-manager
# AUTH_REQUIRED=false
# AUTH_TOKEN_SECRET=generate-a-long-random-secret
# PORTAL_USERS_JSON=[{"username":"client-a","passwordHash":"scrypt$...","tenantId":"tenant-a","allowedCustomerCodes":["CUST-A"]}]
# AUDIT_LOG=console
# TENANT_MAPPINGS_JSON=[{"tenantId":"tenant-a","customerCodes":["CUST-A"],"invoiceUserIds":["101"]}]
# PORTAL_DB_PATH=./data/portal.sqlite
# PORTAL_REQUEST_LIMIT=60
# PORTAL_REQUEST_WINDOW_MS=60000
# Required before New Wisdom monthly billing is enabled. This template must contain {{invoiceUserIds}} or {{invoiceUserIdsCsv}}, {{page}}, and {{pageSize}}.
# Example structure only: replace the two REPLACE_* field names with page-verified filter keys before use.
# NEW_WISDOM_INVOICE_REQUEST_TEMPLATE={"REPLACE_DATE_FIELD":["{{start}}","{{end}}"],"REPLACE_USER_FIELD":"{{invoiceUserIds}}","page":"{{page}}","pageSize":"{{pageSize}}"}
# Generate a passwordHash with: node -e "console.log(require('./server/auth-service').hashPassword('replace-me'))"
